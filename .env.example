# Copie para .env.local e preencha. O .env.local não vai para o GitHub.

# Supabase — projeto "ifesciencia"
NEXT_PUBLIC_SUPABASE_URL=
# Chave publicável: pode aparecer no navegador. Quem manda no que ela
# consegue ler ou escrever são as regras de acesso do banco, não o segredo.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Endereço público do site (imagem de compartilhamento do WhatsApp — etapa 9)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
